# BasicNpcFlow

main: kit: flow: BasicNpcFlow:
{
  entity: "npc",
  kind: "basic",
  name: "BasicNpcFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "npc_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "npc_ref01",
        srcdatavar: "npc_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "npc01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-npc_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNpcFlow"
}