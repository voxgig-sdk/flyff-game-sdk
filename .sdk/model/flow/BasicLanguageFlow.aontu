# BasicLanguageFlow

main: kit: flow: BasicLanguageFlow:
{
  entity: "language",
  kind: "basic",
  name: "BasicLanguageFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "language_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "language_ref01",
        srcdatavar: "language_ref01_data",
        suffix: "_dt0"
      }

      m: {
        language_code: "language_code01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-language_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLanguageFlow"
}