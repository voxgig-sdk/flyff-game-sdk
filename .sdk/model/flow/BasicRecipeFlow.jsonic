# BasicRecipeFlow

main: kit: flow: BasicRecipeFlow:
{
  entity: "recipe",
  kind: "basic",
  name: "BasicRecipeFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "recipe_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "recipe_ref01",
        srcdatavar: "recipe_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "recipe01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-recipe_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRecipeFlow"
}