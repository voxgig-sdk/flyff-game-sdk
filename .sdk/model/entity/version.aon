# Entity: version

main: kit: entity: version: {

  alias: field: {}

  name: "version"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/version/api"
          segments: [
            {
              lit: "version"
            }
            {
              lit: "api"
            }
          ]
          select: {
            "$action": "api"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/version/data"
          segments: [
            {
              lit: "version"
            }
            {
              lit: "data"
            }
          ]
          select: {
            "$action": "data"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
